---
const path = Astro.url.pathname;
const items = [
  { href: '/', label: 'TOP', icon: 'home' },
  { href: '/products/', label: '探す', icon: 'search' },
  { href: '/diagnosis/', label: '診断', icon: 'shield' },
  { href: '/learn/', label: '記事', icon: 'book' },
  { href: '/compare/', label: '比較', icon: 'compare' }
];
const icon = (name: string) => {
  const icons: Record<string, string> = {
    home: '<svg viewBox="0 0 24 24"><path d="M4 10.5 12 4l8 6.5V20H4v-9.5Z"/><path d="M9 20v-6h6v6"/></svg>',
    search: '<svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4"/></svg>',
    shield: '<svg viewBox="0 0 24 24"><path d="M12 3 5.5 5.5v5.9c0 4.3 2.6 7.5 6.5 9.6 3.9-2.1 6.5-5.3 6.5-9.6V5.5L12 3Z"/><path d="m9 12 2 2 4-4"/></svg>',
    book: '<svg viewBox="0 0 24 24"><path d="M4.5 5.5A2.5 2.5 0 0 1 7 3h5v16H7a2.5 2.5 0 0 0-2.5 2V5.5Z"/><path d="M19.5 5.5A2.5 2.5 0 0 0 17 3h-5v16h5a2.5 2.5 0 0 1 2.5 2V5.5Z"/></svg>',
    compare: '<svg viewBox="0 0 24 24"><path d="M7 4v16M17 4v16M4 7l3-3 3 3M14 17l3 3 3-3"/></svg>'
  };
  return icons[name] || '';
};
---
<nav class="bottom-nav" aria-label="モバイルナビゲーション">
  {items.map((item) => {
    const active = item.href === '/' ? path === '/' : path.startsWith(item.href);
    return <a class:list={[{ active }]} href={item.href}><span aria-hidden="true" set:html={icon(item.icon)}></span><small>{item.label}</small></a>;
  })}
</nav>
<style>
  .bottom-nav{display:none}
  @media(max-width:640px){
    .bottom-nav{position:fixed;z-index:70;left:8px;right:8px;bottom:8px;height:64px;display:grid;grid-template-columns:repeat(5,1fr);align-items:center;background:rgba(255,255,255,.96);backdrop-filter:blur(18px);border:1px solid var(--slate-300);border-radius:16px;box-shadow:var(--shadow-float);padding:4px 6px}
    .bottom-nav a{height:54px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;color:var(--slate-500);border-radius:11px}
    .bottom-nav a.active{background:var(--navy-900);color:#fff}
    .bottom-nav span{width:19px;height:19px;display:grid;place-items:center}.bottom-nav :global(svg){width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
    .bottom-nav small{font-size:.58rem;font-weight:800;letter-spacing:.02em}
  }
</style>
