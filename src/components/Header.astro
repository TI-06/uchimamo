---
const path = Astro.url.pathname;
const nav = [
  { href: '/products/', label: '商品を探す' },
  { href: '/diagnosis/', label: '防犯診断' },
  { href: '/compare/', label: '商品比較' },
  { href: '/guide/', label: '防犯ガイド' }
];
---
<header class="header">
  <div class="site-container header-inner">
    <a class="brand" href="/" aria-label="ウチマモ ホーム">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="24" height="24"><path d="M4.5 10.2 12 4l7.5 6.2v7.3a2 2 0 0 1-2 2h-11a2 2 0 0 1-2-2v-7.3Z" fill="none" stroke="currentColor" stroke-width="2"/><path d="m9.3 12.4 1.8 1.8 3.8-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
      <span><strong>ウチマモ</strong><small>HOME SECURITY GUIDE</small></span>
    </a>
    <nav class="desktop-nav" aria-label="メインナビゲーション">
      {nav.map((item) => <a class:list={[{ active: path.startsWith(item.href) }]} href={item.href}>{item.label}</a>)}
    </nav>
    <a class="diagnosis-cta" href="/diagnosis/">30秒で防犯診断 <span>→</span></a>
  </div>
</header>
<style>
  .header{position:sticky;top:0;z-index:50;background:rgba(255,255,255,.88);backdrop-filter:blur(16px);border-bottom:1px solid rgba(214,222,232,.8)}
  .header-inner{height:72px;display:flex;align-items:center;gap:28px}
  .brand{display:flex;align-items:center;gap:10px;margin-right:auto;color:var(--navy-950)}
  .brand-mark{width:42px;height:42px;border-radius:13px;display:grid;place-items:center;color:white;background:linear-gradient(145deg,var(--navy-900),#164d79);box-shadow:0 8px 20px rgba(11,31,54,.18)}
  .brand strong{display:block;font-size:1.1rem;line-height:1.2;letter-spacing:.03em}.brand small{display:block;color:var(--slate-500);font-weight:700;font-size:.58rem;letter-spacing:.13em;margin-top:3px}
  .desktop-nav{display:flex;align-items:center;gap:24px}.desktop-nav a{font-size:.9rem;font-weight:700;color:var(--slate-700);padding:24px 0 21px;border-bottom:3px solid transparent}.desktop-nav a:hover,.desktop-nav a.active{color:var(--blue-600);border-bottom-color:var(--blue-600)}
  .diagnosis-cta{display:inline-flex;align-items:center;gap:7px;background:var(--navy-900);color:#fff;padding:11px 16px;border-radius:12px;font-size:.85rem;font-weight:800}.diagnosis-cta:hover{background:#123e65}
  @media(max-width:820px){.desktop-nav{display:none}.diagnosis-cta{font-size:.78rem}.brand small{display:none}}
  @media(max-width:520px){.header-inner{height:62px}.brand-mark{width:38px;height:38px}.diagnosis-cta{display:none}}
</style>
