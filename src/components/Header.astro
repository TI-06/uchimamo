---
const path = Astro.url.pathname;
const nav = [
  { href: '/products/', label: '商品を探す' },
  { href: '/compare/', label: '商品比較' },
  { href: '/security/', label: '条件から探す' },
  { href: '/learn/', label: '防犯の選び方' },
  { href: '/about/', label: '選定方針' }
];
---
<header class="header">
  <div class="site-container header-inner">
    <a class="brand" href="/" aria-label="ウチマモ ホーム">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 28 28" width="24" height="24"><path d="M4.8 12.1 14 4.7l9.2 7.4v9a2.2 2.2 0 0 1-2.2 2.2H7a2.2 2.2 0 0 1-2.2-2.2v-9Z" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="m10.7 15.1 2.1 2 4.8-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
      <span class="brand-copy"><strong>ウチマモ</strong><small>HOME SECURITY SELECT</small></span>
    </a>
    <nav class="desktop-nav" aria-label="メインナビゲーション">
      {nav.map((item) => <a class:list={[{ active: path.startsWith(item.href) }]} href={item.href}>{item.label}</a>)}
    </nav>
    <a class="diagnosis-cta" href="/diagnosis/"><small>無料・登録不要</small><strong>30秒で防犯診断</strong><span>→</span></a>
  </div>
</header>
<style>
  .header{position:sticky;top:0;z-index:50;background:rgba(248,248,246,.94);backdrop-filter:blur(18px);border-bottom:1px solid rgba(211,218,224,.9)}
  .header-inner{height:72px;display:flex;align-items:center;gap:30px}
  .brand{display:flex;align-items:center;gap:11px;margin-right:auto;color:var(--navy-950)}
  .brand-mark{width:40px;height:40px;border-radius:12px;display:grid;place-items:center;color:var(--navy-900);background:#fff;border:1px solid var(--slate-300);box-shadow:0 6px 18px rgba(7,20,33,.05)}
  .brand-copy strong{display:block;font-size:1.06rem;line-height:1.15;letter-spacing:.06em}.brand-copy small{display:block;color:var(--slate-500);font-weight:700;font-size:.52rem;letter-spacing:.14em;margin-top:4px}
  .desktop-nav{display:flex;align-items:center;gap:28px}.desktop-nav a{position:relative;font-size:.82rem;font-weight:750;color:var(--slate-700);padding:26px 0 23px}.desktop-nav a::after{content:"";position:absolute;left:0;right:0;bottom:17px;height:1px;background:transparent;transition:.16s ease}.desktop-nav a:hover,.desktop-nav a.active{color:var(--navy-950)}.desktop-nav a.active::after{background:var(--navy-900)}
  .diagnosis-cta{min-width:168px;display:grid;grid-template-columns:1fr auto;grid-template-rows:auto auto;align-items:center;column-gap:10px;background:var(--navy-900);color:#fff;padding:9px 14px;border-radius:11px;box-shadow:0 8px 22px rgba(13,33,52,.13)}.diagnosis-cta small{grid-column:1;font-size:.5rem;color:#aebfd0;font-weight:700;letter-spacing:.04em}.diagnosis-cta strong{grid-column:1;font-size:.75rem;line-height:1.25}.diagnosis-cta>span{grid-column:2;grid-row:1/3;color:#fff}.diagnosis-cta:hover{background:#163651}
  @media(max-width:900px){.desktop-nav{display:none}.brand-copy small{display:none}}
  @media(max-width:560px){.header-inner{height:62px}.brand-mark{width:36px;height:36px}.brand-copy strong{font-size:1rem}.diagnosis-cta{display:none}}
</style>
