---
import '../styles/global.css';
import '../styles/compare-dynamic.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BottomNav from '../components/BottomNav.astro';
import productsJson from '../data/products.json';
import cacheJson from '../data/rakuten-cache.json';
import type { Product } from '../types/product';
import type { RakutenCacheItem } from '../lib/rakuten';
import { absoluteUrl, normalizeSiteUrl } from '../lib/seo';
import { buildProductStructuredData } from '../lib/product-structured-data';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  ogImage?: string;
  ogType?: 'website' | 'article';
}

const {
  title = 'ウチマモ｜工事なしで始める、わが家の防犯',
  description = '住まい・設置場所・Wi-Fi・電源・予算から、自分に合う防犯用品を探せる家庭防犯サービス。',
  noindex = false,
  ogImage,
  ogType = 'website'
} = Astro.props;
const base = normalizeSiteUrl(import.meta.env.PUBLIC_SITE_URL || 'https://uchimamo.pages.dev');
const canonical = absoluteUrl(base, Astro.url.pathname);
const products = productsJson as Product[];
const cache = cacheJson as Record<string, RakutenCacheItem>;
const productMatch = Astro.url.pathname.match(/^\/products\/([^/]+)\/?$/);
const currentProduct = productMatch
  ? products.find((product) => product.id === decodeURIComponent(productMatch[1]))
  : undefined;
const currentRakuten = currentProduct ? cache[currentProduct.id] : undefined;
const fallbackOgImage = currentRakuten?.imageUrl;
const resolvedOgImage = ogImage
  ? new URL(ogImage, `${base}/`).toString()
  : fallbackOgImage
    ? new URL(fallbackOgImage, `${base}/`).toString()
    : undefined;
const robots = noindex
  ? 'noindex,nofollow'
  : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1';
const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'ウチマモ',
  url: base,
  description: '工事不要・後付けで始める家庭防犯の商品検索・比較・診断サービス。',
  inLanguage: 'ja'
};
const productStructuredData = currentProduct
  ? buildProductStructuredData({
      product: currentProduct,
      rakuten: currentRakuten,
      baseUrl: base,
      canonicalUrl: canonical
    })
  : undefined;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="author" content="ウチマモ編集部" />
    <meta name="robots" content={robots} />
    <meta name="google-site-verification" content="sF2foqS0K9hluvQTJslEp1ZGHOZv6p19uIvzsBXb03E" />
    <meta name="theme-color" content="#0b1f36" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="ウチマモ" />
    {resolvedOgImage && <meta property="og:image" content={resolvedOgImage} />}
    <meta name="twitter:card" content={resolvedOgImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {resolvedOgImage && <meta name="twitter:image" content={resolvedOgImage} />}
    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
    {productStructuredData && <script type="application/ld+json" set:html={JSON.stringify(productStructuredData)} />}
    <slot name="head" />
    <title>{title}</title>
  </head>
  <body>
    <Header />
    <main><slot /></main>
    <Footer />
    <BottomNav />
  </body>
</html>
