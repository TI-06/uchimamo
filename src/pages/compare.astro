---
import BaseLayout from '../layouts/BaseLayout.astro';
import productsJson from '../data/products.json';
import cacheJson from '../data/rakuten-cache.json';
import type { Product } from '../types/product';
const products = productsJson as Product[];
const cache = cacheJson;
---
<BaseLayout title="防犯用品を3商品まで比較｜ウチマモ" description="防犯カメラやスマートロックを最大3商品まで同じ条件で比較できます。">
  <section class="compare-hero"><div class="site-container"><span class="eyebrow">COMPARE</span><h1>防犯用品を横並びで比較</h1><p>価格だけでなく、工事・通信・電源・月額など「自宅で使えるか」を中心に比べます。</p></div></section>
  <section class="compare-section"><div class="site-container"><div id="emptyCompare" class="empty card"><span>⇄</span><h2>比較する商品を選んでください</h2><p>商品一覧で最大3つまで「比較リストに追加」できます。</p><a class="btn-primary" href="/products/">商品を選びに行く →</a></div><div id="compareContent" hidden><div class="compare-toolbar"><div><strong><span id="selectedCount">0</span>商品を比較中</strong><small>最大3商品</small></div><a href="/products/">＋ 商品を選び直す</a></div><div class="table-wrap card"><table><thead id="compareHead"></thead><tbody id="compareBody"></tbody></table></div><div class="compare-tip card"><strong>比較だけで決めきれない場合</strong><p>自宅の設置条件を入力すると、条件との相性で候補を並べ直せます。</p><a class="btn-secondary" href="/diagnosis/">防犯診断を試す →</a></div></div></div></section>
</BaseLayout>
<script define:vars={{ products, cache }}>
  const ids = (new URLSearchParams(location.search).get('ids') || '').split(',').filter(Boolean).slice(0,3);
  const selected = ids.map((id) => products.find((p) => p.id === id)).filter(Boolean);
  const empty = document.querySelector('#emptyCompare'); const content = document.querySelector('#compareContent');
  const yes = (value) => value ? '<span class="yes">✓ 対応</span>' : '<span class="no">—</span>';
  const labels = { camera:'防犯カメラ','smart-lock':'スマートロック',sensor:'センサー','window-lock':'補助錠',light:'ライト' };
  if (selected.length) {
    if (empty instanceof HTMLElement) empty.hidden = true; if (content instanceof HTMLElement) content.hidden = false;
    const count = document.querySelector('#selectedCount'); if (count) count.textContent = String(selected.length);
    const head = document.querySelector('#compareHead'); if (head) head.innerHTML = `<tr><th>比較項目</th>${selected.map((p) => `<th><small>${p.brand}</small><strong>${p.name}</strong><a href="/products/${p.id}/">詳細を見る →</a></th>`).join('')}</tr>`;
    const rows = [
      ['カテゴリ', (p) => labels[p.category] || p.category],
      ['ウチマモ評価', (p) => `<b class="score">${p.score}</b><small>/100</small>`],
      ['工事・穴あけ不要', (p) => yes(p.installation.noDrilling)],
      ['屋外対応', (p) => yes(p.installation.outdoor)],
      ['Wi-Fi不要', (p) => yes(!p.connectivity.wifiRequired)],
      ['バッテリー', (p) => yes(p.power.battery)],
      ['ソーラー', (p) => yes(p.power.solar)],
      ['月額不要', (p) => yes(!p.monthlyFeeRequired)],
      ['楽天価格', (p) => cache[p.id]?.price ? `<strong>¥${Number(cache[p.id].price).toLocaleString('ja-JP')}</strong>` : '同期後に表示'],
      ['購入', (p) => cache[p.id]?.affiliateUrl ? `<a class="buy" href="${cache[p.id].affiliateUrl}" target="_blank" rel="nofollow sponsored noopener">楽天で見る</a>` : '<small>楽天連携待ち</small>']
    ];
    const body = document.querySelector('#compareBody'); if (body) body.innerHTML = rows.map(([label,render]) => `<tr><th>${label}</th>${selected.map((p) => `<td>${render(p)}</td>`).join('')}</tr>`).join('');
  }
</script>
<style>
  .compare-hero{padding:58px 0 36px;background:linear-gradient(180deg,#f4f9ff,#fff);border-bottom:1px solid var(--slate-200)}.compare-hero h1{font-size:clamp(2rem,4vw,3.1rem);letter-spacing:-.045em;margin:7px 0;color:var(--navy-950)}.compare-hero p{margin:0;color:var(--slate-700)}.compare-section{padding:36px 0 76px}.empty{text-align:center;padding:70px 20px}.empty>span{width:60px;height:60px;display:grid;place-items:center;border-radius:18px;background:var(--blue-100);color:var(--blue-600);font-size:1.6rem;margin:0 auto 14px}.empty h2{margin:0;color:var(--navy-950)}.empty p{color:var(--slate-500);font-size:.82rem}.empty .btn-primary{margin-top:10px}.compare-toolbar{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px}.compare-toolbar strong{display:block}.compare-toolbar small{display:block;color:var(--slate-500);font-size:.65rem}.compare-toolbar>a{color:var(--blue-600);font-size:.72rem;font-weight:900}.table-wrap{overflow:auto}.table-wrap table{width:100%;border-collapse:collapse;min-width:720px}.table-wrap th,.table-wrap td{padding:15px;border-bottom:1px solid var(--slate-200);text-align:center;vertical-align:middle}.table-wrap tbody th,.table-wrap thead th:first-child{width:160px;text-align:left;background:#f8fafc;color:var(--slate-700);font-size:.72rem}.table-wrap thead th{padding:20px 15px;background:#fff}.table-wrap thead small{display:block;color:var(--blue-600);font-size:.6rem;font-weight:900}.table-wrap thead strong{display:block;color:var(--navy-950);font-size:.85rem;max-width:220px;margin:3px auto}.table-wrap thead a{font-size:.62rem;color:var(--blue-600);font-weight:800}.table-wrap td{font-size:.75rem;color:var(--slate-700)}.table-wrap :global(.yes){color:var(--green-600);font-weight:900}.table-wrap :global(.no){color:var(--slate-300)}.table-wrap :global(.score){font-size:1.25rem;color:var(--navy-950)}.table-wrap :global(.buy){display:inline-block;padding:8px 12px;background:var(--blue-600);color:white;border-radius:9px;font-weight:900;font-size:.68rem}.compare-tip{margin-top:18px;padding:20px;display:grid;grid-template-columns:1fr auto;align-items:center;gap:4px 20px}.compare-tip strong{color:var(--navy-950)}.compare-tip p{margin:0;color:var(--slate-500);font-size:.72rem}.compare-tip a{grid-column:2;grid-row:1/3;font-size:.72rem}
  @media(max-width:640px){.compare-hero{padding:36px 0 26px}.compare-section{padding-top:24px}.table-wrap{margin-inline:-12px;border-radius:0;border-inline:0}.compare-tip{grid-template-columns:1fr}.compare-tip a{grid-column:1;grid-row:auto;margin-top:10px}}
</style>
