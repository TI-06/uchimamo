---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="30秒でわが家の防犯診断｜ウチマモ" description="住まい、守りたい場所、電源、Wi-Fi、工事可否、予算の6問から家庭防犯の優先対策と商品候補を診断します。">
  <section class="diagnosis-shell">
    <div class="site-container diagnosis-wrap">
      <div class="diagnosis-head"><a href="/" class="back-home">← TOPへ</a><div><span>無料</span><span>登録不要</span><span>個人情報入力なし</span></div></div>

      <div id="diagnosisApp" class="diagnosis-card surface">
        <div class="progress-head"><div><small id="stepLabel">STEP 1 / 6</small><strong id="questionTitle">住まいのタイプを教えてください</strong></div><span id="percent">17%</span></div>
        <div class="progress"><i id="progressBar"></i></div>
        <div id="options" class="option-grid"></div>
        <div class="controls"><button id="backButton" type="button" class="text-button" disabled>← 戻る</button><small>回答はブラウザ内で診断にのみ使用します</small></div>
      </div>

      <div id="resultPanel" class="result-panel" hidden>
        <div class="result-top">
          <div class="result-copy"><span class="eyebrow">YOUR SECURITY PLAN</span><h1>あなたの防犯プラン</h1><p>入力した条件から、設置しやすさと生活環境を優先して対策候補を整理しました。</p><a href="#whyResult">なぜこの結果？ →</a></div>
          <div class="score"><div class="score-ring"><strong id="scoreValue">0</strong><small>/100</small></div><div><small>防犯準備スコア</small><strong id="scoreStatus">要対策</strong><span>ウチマモ独自診断</span></div></div>
        </div>

        <div class="result-grid">
          <section><div class="result-section-head"><span>01</span><div><small>PRIORITY</small><h2>優先して対策したいこと</h2></div></div><div id="priorities" class="priority-list"></div></section>
          <section><div class="result-section-head"><span>02</span><div><small>PRODUCTS</small><h2>条件に合う商品候補</h2></div></div><div id="recommendations" class="recommend-list"></div></section>
        </div>

        <div id="whyResult" class="why-result surface"><div><span class="eyebrow">WHY THIS RESULT?</span><h2>診断結果の考え方</h2></div><div><p>商品単体の人気順ではなく、あなたが選んだ「設置場所・Wi-Fi・電源・穴あけ可否・予算」を優先して候補を絞っています。</p><p>ウチマモ評価と楽天市場レビューは別の指標です。価格・在庫・最新仕様は購入前に販売ページで確認してください。</p></div></div>

        <div class="result-actions"><div><strong>条件を変えてもう一度診断</strong><small>別の場所や家族の住まいでも試せます。</small></div><button id="restartButton" type="button" class="btn-secondary">最初からやり直す</button><a class="btn-primary" href="/products/">全商品から探す <span>→</span></a></div>
      </div>
    </div>
  </section>
</BaseLayout>
<script>
  import products from '../../data/products.json';
  import cache from '../../data/rakuten-cache.json';
  import { diagnoseSecurity } from '../../lib/diagnosis';

  const questions = [
    { key: 'residence', title: '住まいのタイプを教えてください', subtitle: '設置方法や守るべき場所の傾向が変わります', options: [['house','戸建て','持ち家の一戸建て'],['apartment','マンション','分譲マンション'],['rental','賃貸','賃貸住宅・アパート'],['parents-home','実家','離れて暮らす家族の家'],['vacant-home','空き家','普段は人がいない家']] },
    { key: 'place', title: 'いちばん守りたい場所は？', subtitle: 'まず1か所に絞って優先順位を出します', options: [['entrance','玄関','鍵・来訪者対策'],['window','窓','侵入・開閉対策'],['parking','駐車場','車・屋外監視'],['garden','庭','敷地への侵入対策'],['backdoor','勝手口','死角になりやすい出入口'],['indoor','室内','見守り・異常検知']] },
    { key: 'power', title: '設置場所に電源はありますか？', subtitle: 'カメラ・ライト選びで重要な条件です', options: [['available','ある','コンセント等を使える'],['none','ない','バッテリー・ソーラーを優先'],['unknown','わからない','条件を広めに判定']] },
    { key: 'wifi', title: 'Wi-Fiは利用できますか？', subtitle: '実家・空き家・屋外では特に重要です', options: [['available','使える','設置場所までWi-Fiが届く'],['none','使えない','Wi-Fi不要・LTE等を優先'],['unknown','わからない','通信条件を広めに判定']] },
    { key: 'drilling', title: '壁やドアへの穴あけは可能ですか？', subtitle: '工事不可なら後付け製品を優先します', options: [['no','穴あけNG','賃貸・外壁を傷つけたくない'],['yes','穴あけOK','固定方法の選択肢を広げる'],['unknown','わからない','工事不要をやや優先']] },
    { key: 'budget', title: 'まず使える予算は？', subtitle: '1か所の対策に使う目安で選んでください', options: [[5000,'〜5,000円','補助錠・センサー中心'],[10000,'〜10,000円','ライト・簡易機器も候補'],[30000,'〜30,000円','カメラ・スマートロックも比較'],[50000,'〜50,000円','複数機器の組み合わせも候補'],[100000,'予算優先なし','機能を優先して選ぶ']] }
  ];
  let step = 0;
  const answers = {};
  const app = document.querySelector('#diagnosisApp');
  const result = document.querySelector('#resultPanel');
  const options = document.querySelector('#options');
  const back = document.querySelector('#backButton');
  const escapeHtml = (value) => String(value ?? '').replace(/[&<>'"]/g, (char) => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[char]));

  function renderQuestion() {
    const q = questions[step];
    const label = document.querySelector('#stepLabel'); const title = document.querySelector('#questionTitle'); const percent = document.querySelector('#percent'); const bar = document.querySelector('#progressBar');
    if (label) label.textContent = `STEP ${step + 1} / ${questions.length}`;
    if (title) title.innerHTML = `${q.title}<small>${q.subtitle}</small>`;
    const pct = Math.round(((step + 1) / questions.length) * 100);
    if (percent) percent.textContent = `${pct}%`; if (bar instanceof HTMLElement) bar.style.width = `${pct}%`;
    if (back instanceof HTMLButtonElement) back.disabled = step === 0;
    if (!options) return;
    options.innerHTML = '';
    q.options.forEach(([value, text, sub]) => {
      const button = document.createElement('button'); button.type = 'button'; button.className = 'option-card';
      button.innerHTML = `<span class="option-icon">${answers[q.key] === value ? '✓' : '○'}</span><span><strong>${text}</strong><small>${sub}</small></span><b>→</b>`;
      button.addEventListener('click', () => { answers[q.key] = value; if (step < questions.length - 1) { step++; renderQuestion(); } else showResult(); });
      options.appendChild(button);
    });
  }

  function recommendationReason(p) {
    const reasons = [];
    if (answers.place && p.places?.includes(answers.place)) reasons.push('守りたい場所に対応');
    if (answers.drilling === 'no' && p.installation?.noDrilling) reasons.push('穴あけNG条件に合致');
    if (answers.wifi === 'none' && !p.connectivity?.wifiRequired) reasons.push('Wi-Fi不要');
    if (answers.power === 'none' && (p.power?.battery || p.power?.solar)) reasons.push('コンセントなしでも比較しやすい');
    if (!p.monthlyFeeRequired) reasons.push('基本は月額不要');
    return reasons.slice(0,3).join('・') || p.editorial?.bestFor || '入力条件との相性から候補に入りました';
  }

  function showResult() {
    const output = diagnoseSecurity(answers, products);
    if (app instanceof HTMLElement) app.hidden = true; if (result instanceof HTMLElement) result.hidden = false;
    const score = document.querySelector('#scoreValue'); if (score) score.textContent = String(output.score);
    const status = document.querySelector('#scoreStatus'); if (status) status.textContent = output.score >= 75 ? '比較的整えやすい' : output.score >= 55 ? '対策を追加したい' : '優先対策あり';
    const priorities = document.querySelector('#priorities'); if (priorities) priorities.innerHTML = output.priorities.map((item, i) => `<article class="priority"><span>${String(i+1).padStart(2,'0')}</span><div><small class="level ${item.level}">${item.level.toUpperCase()}</small><strong>${escapeHtml(item.title)}</strong><p>${escapeHtml(item.reason)}</p></div></article>`).join('');
    const recommendations = document.querySelector('#recommendations');
    if (recommendations) {
      recommendations.innerHTML = output.recommendedProductIds.map((id, i) => {
        const p = products.find((item) => item.id === id); if (!p) return '';
        const r = cache[id];
        const price = r?.price ? `¥${Number(r.price).toLocaleString('ja-JP')}` : '価格確認中';
        const image = r?.imageUrl ? `<img src="${escapeHtml(r.imageUrl)}" alt="" />` : `<span class="recommend-placeholder">${escapeHtml(p.brand.slice(0,2))}</span>`;
        const review = r?.reviewAverage > 0 ? `<span class="recommend-review">楽天市場レビュー <b>★ ${Number(r.reviewAverage).toFixed(1)}</b> (${Number(r.reviewCount || 0).toLocaleString('ja-JP')}件)</span>` : '';
        const rakuten = r?.affiliateUrl ? `<a class="recommend-buy" href="${escapeHtml(r.affiliateUrl)}" target="_blank" rel="nofollow sponsored noopener">楽天で価格を見る</a>` : '';
        return `<article class="recommend"><div class="recommend-rank">0${i+1}</div><div class="recommend-image">${image}</div><div class="recommend-copy"><small>${escapeHtml(p.brand)}</small><strong>${escapeHtml(p.name)}</strong><p>${escapeHtml(recommendationReason(p))}</p><div class="recommend-meta"><span>ウチマモ評価 <b>${p.score}</b></span>${review}</div><div class="recommend-price"><small>楽天市場</small><b>${price}</b></div><div class="recommend-links"><a href="/products/${encodeURIComponent(p.id)}/">商品詳細 →</a>${rakuten}</div></div></article>`;
      }).join('') || '<div class="no-match surface">該当候補が少ないため、商品一覧から条件を広げて探してください。</div>';
    }
    result?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  back?.addEventListener('click', () => { if (step > 0) { step--; renderQuestion(); } });
  document.querySelector('#restartButton')?.addEventListener('click', () => { Object.keys(answers).forEach((key) => delete answers[key]); step = 0; if (result instanceof HTMLElement) result.hidden = true; if (app instanceof HTMLElement) app.hidden = false; renderQuestion(); window.scrollTo({top:0,behavior:'smooth'}); });
  renderQuestion();
</script>
<style>
  .diagnosis-shell{min-height:calc(100vh - 72px);padding:34px 0 78px;background:#f5f6f4}.diagnosis-wrap{max-width:980px}.diagnosis-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:17px;font-size:.64rem;font-weight:800;color:var(--slate-500)}.back-home:hover{color:var(--navy-950)}.diagnosis-head>div{display:flex;gap:5px}.diagnosis-head span{background:#fff;color:var(--slate-600);border:1px solid var(--slate-200);padding:4px 8px;border-radius:999px}.diagnosis-card{padding:36px 40px;min-height:540px;background:#fff}.progress-head{display:flex;justify-content:space-between;gap:20px}.progress-head small{display:block;color:var(--blue-700);font-size:.62rem;font-weight:900;letter-spacing:.12em}.progress-head strong{display:block;font-size:1.55rem;color:var(--navy-950);margin-top:6px;line-height:1.4}.progress-head strong :global(small){display:block;color:var(--slate-500);font-size:.7rem;font-weight:600;letter-spacing:0;margin-top:5px}.progress-head>span{color:var(--slate-500);font-size:.66rem;font-weight:800}.progress{height:4px;background:var(--slate-100);border-radius:99px;margin:18px 0 32px;overflow:hidden}.progress i{display:block;height:100%;width:17%;background:var(--navy-900);border-radius:99px;transition:width .25s ease}.option-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.option-grid :global(.option-card){text-align:left;border:1px solid var(--slate-200);background:#fff;border-radius:13px;min-height:86px;padding:14px 15px;display:grid;grid-template-columns:34px 1fr 18px;align-items:center;gap:10px;cursor:pointer;color:var(--slate-900);transition:.16s ease}.option-grid :global(.option-card:hover){border-color:#adb9c4;background:#fafbfb;transform:translateY(-1px);box-shadow:var(--shadow-sm)}.option-grid :global(.option-icon){width:31px;height:31px;display:grid;place-items:center;border-radius:9px;background:var(--warm-100);color:var(--navy-900);font-weight:900}.option-grid :global(.option-card strong){display:block;font-size:.82rem}.option-grid :global(.option-card small){display:block;color:var(--slate-500);font-size:.64rem;margin-top:3px}.option-grid :global(.option-card b){color:var(--slate-400)}.controls{display:flex;justify-content:space-between;align-items:center;margin-top:30px;border-top:1px solid var(--slate-200);padding-top:18px}.controls small{color:var(--slate-400);font-size:.58rem}.text-button{border:0;background:transparent;color:var(--blue-700);font-weight:800;font-size:.68rem;cursor:pointer}.text-button:disabled{color:var(--slate-300);cursor:default}
  .result-panel[hidden]{display:none}.result-top{background:var(--navy-950);border-radius:18px;padding:34px 38px;display:flex;justify-content:space-between;align-items:center;gap:30px;color:white}.result-copy .eyebrow{color:#9bb9d2}.result-copy h1{font-size:2.2rem;letter-spacing:-.04em;margin:4px 0}.result-copy p{margin:0;color:#a8b8c7;font-size:.8rem;max-width:580px}.result-copy>a{display:inline-block;margin-top:12px;color:#d8e4ed;font-size:.62rem;font-weight:900}.score{display:flex;align-items:center;gap:13px}.score-ring{width:94px;height:94px;border-radius:50%;border:7px solid rgba(255,255,255,.14);border-top-color:#fff;border-right-color:#fff;display:grid;place-items:center;position:relative}.score-ring strong{font-size:1.8rem}.score-ring small{position:absolute;bottom:14px;font-size:.5rem;color:#9fb1c2}.score>div:last-child small{display:block;color:#9fb1c2;font-size:.56rem}.score>div:last-child strong{display:block;font-size:.82rem}.score>div:last-child span{display:block;color:#7890a6;font-size:.5rem;margin-top:3px}
  .result-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:34px;margin-top:42px}.result-section-head{display:flex;gap:10px;align-items:center;margin-bottom:13px}.result-section-head>span{color:var(--slate-400);font-size:.58rem;font-weight:900}.result-section-head small{display:block;color:var(--blue-700);font-size:.5rem;font-weight:900;letter-spacing:.1em}.result-section-head h2{font-size:1.05rem;color:var(--navy-950);margin:1px 0}.priority-list,.recommend-list{display:grid;gap:9px}.priority-list :global(.priority){background:#fff;border:1px solid var(--slate-200);border-radius:12px;padding:14px;display:grid;grid-template-columns:34px 1fr;gap:10px}.priority-list :global(.priority>span){color:var(--slate-400);font-size:.58rem;font-weight:900}.priority-list :global(.priority strong){display:block;font-size:.77rem}.priority-list :global(.priority p){font-size:.63rem;color:var(--slate-500);margin:3px 0}.priority-list :global(.level){font-size:.5rem;font-weight:900}.priority-list :global(.level.high){color:var(--red-600)}.priority-list :global(.level.medium){color:var(--orange-600)}.priority-list :global(.level.low){color:var(--green-600)}
  .recommend-list :global(.recommend){position:relative;background:#fff;border:1px solid var(--slate-200);border-radius:13px;display:grid;grid-template-columns:130px 1fr;overflow:hidden}.recommend-list :global(.recommend-rank){position:absolute;left:8px;top:6px;color:var(--slate-400);font-size:.5rem;font-weight:900;z-index:2}.recommend-list :global(.recommend-image){background:#f4f5f3;display:grid;place-items:center;padding:13px;border-right:1px solid var(--slate-200)}.recommend-list :global(.recommend-image img){width:100%;height:105px;object-fit:contain}.recommend-list :global(.recommend-placeholder){width:54px;height:54px;border-radius:13px;background:#fff;display:grid;place-items:center;font-weight:900}.recommend-list :global(.recommend-copy){padding:13px}.recommend-list :global(.recommend-copy>small){display:block;color:var(--blue-700);font-size:.5rem;font-weight:900}.recommend-list :global(.recommend-copy>strong){display:block;font-size:.73rem;line-height:1.45;margin:2px 0}.recommend-list :global(.recommend-copy>p){font-size:.59rem;color:var(--green-600);font-weight:800;margin:4px 0 7px}.recommend-list :global(.recommend-meta){display:flex;gap:8px;flex-wrap:wrap;color:var(--slate-500);font-size:.5rem}.recommend-list :global(.recommend-meta b){color:var(--navy-950)}.recommend-list :global(.recommend-review b){color:var(--orange-600)}.recommend-list :global(.recommend-price){margin-top:6px}.recommend-list :global(.recommend-price small){color:var(--slate-500);font-size:.48rem;margin-right:6px}.recommend-list :global(.recommend-price b){font-size:.78rem}.recommend-list :global(.recommend-links){display:flex;gap:10px;margin-top:7px}.recommend-list :global(.recommend-links a){font-size:.55rem;color:var(--blue-700);font-weight:900}.recommend-list :global(.recommend-links .recommend-buy){color:var(--navy-950)}.no-match{padding:18px;color:var(--slate-500);font-size:.7rem}
  .why-result{margin-top:38px;padding:25px 28px;display:grid;grid-template-columns:.6fr 1.4fr;gap:40px}.why-result h2{font-size:1.1rem;margin:3px 0}.why-result p{margin:0;color:var(--slate-600);font-size:.67rem}.why-result p+p{margin-top:8px}.result-actions{margin-top:18px;background:#fff;border:1px solid var(--slate-200);border-radius:13px;padding:17px 18px;display:grid;grid-template-columns:1fr auto auto;align-items:center;gap:12px}.result-actions strong{display:block;font-size:.72rem}.result-actions small{display:block;color:var(--slate-500);font-size:.56rem}.result-actions .btn-primary,.result-actions .btn-secondary{min-height:40px;font-size:.64rem}
  @media(max-width:760px){.diagnosis-shell{padding-top:20px}.diagnosis-card{padding:25px 20px;min-height:500px}.option-grid{grid-template-columns:1fr}.result-top{display:block;padding:28px 22px}.score{margin-top:22px}.result-grid{grid-template-columns:1fr;gap:30px}.why-result{grid-template-columns:1fr;gap:10px}.result-actions{grid-template-columns:1fr 1fr}.result-actions>div{grid-column:1/-1}.recommend-list :global(.recommend){grid-template-columns:110px 1fr}}
  @media(max-width:480px){.diagnosis-head>div span:nth-child(3){display:none}.progress-head strong{font-size:1.28rem}.recommend-list :global(.recommend){grid-template-columns:1fr}.recommend-list :global(.recommend-image){height:150px;border-right:0;border-bottom:1px solid var(--slate-200)}.recommend-list :global(.recommend-image img){height:130px}.result-actions{grid-template-columns:1fr}.result-actions>div{grid-column:auto}}
</style>
