---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { guides, type Guide } from '../../data/guides';
import { absoluteUrl, normalizeSiteUrl } from '../../lib/seo';

export function getStaticPaths() {
  return guides.map((guide) => ({ params: { slug: guide.slug }, props: { guide } }));
}

interface Props { guide: Guide }
const { guide } = Astro.props;
const base = normalizeSiteUrl(import.meta.env.PUBLIC_SITE_URL || 'https://uchimamo.pages.dev');
const articleUrl = absoluteUrl(base, `/guide/${guide.slug}/`);
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: guide.title,
  description: guide.description,
  url: articleUrl,
  mainEntityOfPage: articleUrl,
  author: { '@type': 'Organization', name: 'ウチマモ' },
  publisher: { '@type': 'Organization', name: 'ウチマモ' },
  datePublished: '2026-08-19',
  dateModified: '2026-08-19'
};
const productHref = guide.productQuery ? `/products/?${guide.productQuery}` : '/products/';
---
<BaseLayout title={`${guide.title}｜ウチマモ`} description={guide.description}>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} /></Fragment>
  <div class="site-container breadcrumb"><a href="/">TOP</a><span>›</span><a href="/guide/">防犯ガイド</a><span>›</span><b>{guide.category}</b></div>
  <article class="article">
    <header class="article-hero">
      <div class="site-container article-narrow">
        <div class="meta"><span class="chip chip-blue">{guide.category}</span><span>{guide.readMinutes}分で読めます</span><span>更新: 2026.08.19</span></div>
        <h1>{guide.title}</h1>
        <p class="lead">{guide.description}</p>
        <div class="conclusion"><span>この記事の結論</span><strong>{guide.conclusion}</strong></div>
      </div>
    </header>

    <div class="site-container article-layout">
      <div class="article-body">
        <aside class="toc card">
          <strong>この記事で確認すること</strong>
          <ol>{guide.sections.map((section, i) => <li><a href={`#section-${i + 1}`}>{section.heading}</a></li>)}</ol>
        </aside>

        {guide.sections.map((section, i) => <section class="article-section" id={`section-${i + 1}`}>
          <div class="section-number">{String(i + 1).padStart(2,'0')}</div>
          <h2>{section.heading}</h2>
          {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          {section.bullets && <ul>{section.bullets.map((item) => <li>{item}</li>)}</ul>}
        </section>)}

        <section class="source-box card">
          <span class="eyebrow">PUBLIC SOURCE</span>
          <h2>公的情報も確認する</h2>
          <p>商品を選ぶ前に、施錠や建物部品など基本的な防犯対策も確認してください。ウチマモでは商品購入だけで防犯が完成するとは考えません。</p>
          <a href={guide.source.url} target="_blank" rel="noopener noreferrer">{guide.source.label} ↗</a>
        </section>

        <section class="article-cta">
          <div><span class="eyebrow">NEXT ACTION</span><h2>条件に合う商品だけに絞り込む</h2><p>工事・Wi-Fi・電源などの条件から、このガイドに関連する防犯用品を比較できます。</p></div>
          <a class="btn-primary" href={productHref}>関連商品を探す →</a>
        </section>
      </div>

      <aside class="side">
        <div class="diagnosis-card card"><span>30 SEC CHECK</span><strong>自宅には何が必要？</strong><p>6問で優先対策と商品候補を整理します。</p><a class="btn-primary" href="/diagnosis/">防犯診断をする →</a></div>
        <div class="side-links card"><strong>商品から探す</strong><a href="/products/?place=entrance">玄関 →</a><a href="/products/?place=window">窓 →</a><a href="/products/?place=parking">駐車場 →</a><a href="/products/?condition=no-drilling">工事不要 →</a><a href="/products/?condition=no-wifi">Wi-Fi不要 →</a></div>
      </aside>
    </div>
  </article>
</BaseLayout>
<style>
  .breadcrumb{padding-top:22px;display:flex;gap:8px;align-items:center;color:var(--slate-500);font-size:.66rem}.breadcrumb a:hover{color:var(--blue-600)}.breadcrumb b{font-weight:700;color:var(--slate-700)}
  .article-hero{padding:48px 0 52px;background:linear-gradient(180deg,#f4f9ff,#fff);border-bottom:1px solid var(--slate-200)}.article-narrow{max-width:900px}.meta{display:flex;align-items:center;gap:12px;color:var(--slate-500);font-size:.65rem}.article-hero h1{font-size:clamp(2rem,4.8vw,3.5rem);line-height:1.28;letter-spacing:-.045em;color:var(--navy-950);margin:16px 0 13px}.lead{font-size:.95rem;color:var(--slate-700);max-width:820px}.conclusion{margin-top:28px;padding:18px 21px;border-radius:16px;background:var(--navy-900);color:white;box-shadow:var(--shadow-sm)}.conclusion span{display:block;color:#83bfff;font-size:.62rem;font-weight:900;letter-spacing:.08em;margin-bottom:5px}.conclusion strong{font-size:.9rem;line-height:1.7}
  .article-layout{display:grid;grid-template-columns:minmax(0,1fr) 260px;gap:40px;align-items:start;padding-top:42px}.article-body{max-width:800px}.toc{padding:20px;margin-bottom:42px;background:#fbfdff}.toc>strong{display:block;color:var(--navy-950);font-size:.78rem;margin-bottom:8px}.toc ol{margin:0;padding-left:24px}.toc li{padding:4px 0;color:var(--slate-500);font-size:.72rem}.toc a:hover{color:var(--blue-600)}
  .article-section{position:relative;padding:0 0 46px 54px;scroll-margin-top:100px}.article-section:before{content:"";position:absolute;left:19px;top:38px;bottom:8px;width:1px;background:var(--slate-200)}.section-number{position:absolute;left:0;top:0;width:39px;height:39px;border-radius:12px;background:var(--blue-100);color:var(--blue-600);display:grid;place-items:center;font-size:.65rem;font-weight:950}.article-section h2{font-size:1.45rem;line-height:1.45;color:var(--navy-950);margin:0 0 14px;letter-spacing:-.025em}.article-section p{font-size:.87rem;color:var(--slate-700);margin:0 0 14px}.article-section ul{margin:16px 0;padding:15px 18px 15px 38px;border-radius:13px;background:var(--slate-100)}.article-section li{font-size:.8rem;color:var(--slate-700);padding:3px 0}
  .source-box{padding:24px;margin:3px 0 36px}.source-box h2{margin:5px 0 7px;color:var(--navy-950);font-size:1.1rem}.source-box p{font-size:.78rem;color:var(--slate-700)}.source-box a{display:inline-block;color:var(--blue-600);font-size:.72rem;font-weight:900;margin-top:5px}.article-cta{background:linear-gradient(135deg,var(--navy-950),#123f67);border-radius:20px;padding:28px;color:white;display:flex;align-items:center;justify-content:space-between;gap:25px}.article-cta .eyebrow{color:#83bfff}.article-cta h2{font-size:1.2rem;margin:5px 0}.article-cta p{font-size:.73rem;color:#b6c9dc;margin:0;max-width:520px}.article-cta .btn-primary{white-space:nowrap}
  .side{position:sticky;top:94px;display:grid;gap:13px}.diagnosis-card{padding:19px;background:linear-gradient(145deg,#f3f9ff,#fff)}.diagnosis-card>span{font-size:.58rem;font-weight:900;letter-spacing:.09em;color:var(--blue-600)}.diagnosis-card>strong{display:block;font-size:.95rem;color:var(--navy-950);margin:5px 0}.diagnosis-card p{font-size:.68rem;color:var(--slate-500)}.diagnosis-card .btn-primary{width:100%;min-height:42px;font-size:.7rem;padding-inline:8px}.side-links{padding:18px}.side-links>strong{display:block;font-size:.75rem;color:var(--navy-950);padding-bottom:9px;border-bottom:1px solid var(--slate-200);margin-bottom:6px}.side-links a{display:flex;justify-content:space-between;padding:7px 0;color:var(--slate-600);font-size:.7rem;font-weight:700}.side-links a:hover{color:var(--blue-600)}
  @media(max-width:850px){.article-layout{grid-template-columns:1fr}.article-body{max-width:none}.side{position:static;grid-template-columns:1fr 1fr}.article-cta{margin-bottom:10px}}
  @media(max-width:640px){.article-hero{padding:34px 0 38px}.meta{flex-wrap:wrap}.article-hero h1{font-size:2rem}.article-layout{padding-top:26px;gap:24px}.toc{margin-bottom:34px}.article-section{padding-left:0;padding-bottom:38px}.article-section:before{display:none}.section-number{position:static;margin-bottom:10px}.article-section h2{font-size:1.25rem}.article-section p{font-size:.84rem}.article-cta{display:block;padding:23px 19px}.article-cta .btn-primary{margin-top:17px}.side{grid-template-columns:1fr}}
</style>
