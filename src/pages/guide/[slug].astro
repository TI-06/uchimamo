---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { guides, type Guide } from '../../data/guides';
import { absoluteUrl, normalizeSiteUrl } from '../../lib/seo';

export function getStaticPaths() {
  return guides.map((guide) => ({ params: { slug: guide.slug }, props: { guide } }));
}

interface Props { guide: Guide }
const { guide } = Astro.props;
const base = normalizeSiteUrl(import.meta.env.PUBLIC_SITE_URL || 'https://uchimamo.pages.dev');
const articleUrl = absoluteUrl(base, `/guide/${guide.slug}/`);
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: guide.title,
  description: guide.description,
  url: articleUrl,
  mainEntityOfPage: articleUrl,
  author: { '@type': 'Organization', name: 'ウチマモ' },
  publisher: { '@type': 'Organization', name: 'ウチマモ' },
  datePublished: '2026-08-19',
  dateModified: '2026-08-19'
};
const productHref = guide.productQuery ? `/products/?${guide.productQuery}` : '/products/';
---
<BaseLayout title={`${guide.title}｜ウチマモ`} description={guide.description}>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} /></Fragment>
  <div class="site-container breadcrumb"><a href="/">TOP</a><span>›</span><a href="/guide/">防犯ガイド</a><span>›</span><b>{guide.category}</b></div>
  <article class="article">
    <header class="article-hero">
      <div class="site-container article-narrow">
        <div class="meta"><span class="category">{guide.category}</span><span>{guide.readMinutes}分で読めます</span><span>更新 2026.08.19</span><a href="/about/">編集方針</a></div>
        <h1>{guide.title}</h1>
        <p class="lead">{guide.description}</p>
        <div class="reader-line"><small>この記事はこんな人向け</small><strong>{guide.category}の防犯を、商品購入の前に順序立てて考えたい人</strong></div>
        <div class="conclusion"><span>CONCLUSION</span><div><small>この記事の結論</small><strong>{guide.conclusion}</strong></div></div>
      </div>
    </header>

    <div class="site-container article-layout">
      <div class="article-body">
        <aside class="toc">
          <div><span class="eyebrow">CONTENTS</span><strong>この記事で確認すること</strong></div>
          <ol>{guide.sections.map((section, i) => <li><a href={`#section-${i + 1}`}><span>{String(i + 1).padStart(2,'0')}</span>{section.heading}</a></li>)}</ol>
        </aside>

        {guide.sections.map((section, i) => <section class="article-section" id={`section-${i + 1}`}>
          <div class="section-number">{String(i + 1).padStart(2,'0')}</div>
          <h2>{section.heading}</h2>
          {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          {section.bullets && <ul>{section.bullets.map((item) => <li>{item}</li>)}</ul>}
        </section>)}

        <section class="source-box">
          <div><span class="eyebrow">PUBLIC SOURCE</span><h2>公的情報も確認する</h2></div>
          <div><p>商品を選ぶ前に、施錠や建物部品など基本的な防犯対策も確認してください。ウチマモでは商品購入だけで防犯が完成するとは考えません。</p><a href={guide.source.url} target="_blank" rel="noopener noreferrer">{guide.source.label} ↗</a></div>
        </section>

        <section class="article-note"><span>PR / EDITORIAL POLICY</span><p>関連商品へのリンクにはアフィリエイト広告を含む場合があります。商品評価は広告報酬ではなく、設置条件・機能・維持しやすさなどウチマモの選定軸で整理しています。</p><a href="/affiliate-policy/">広告掲載方針を見る →</a></section>

        <section class="article-cta"><div><span class="eyebrow">NEXT ACTION</span><h2>条件に合う商品だけに絞り込む</h2><p>工事・Wi-Fi・電源などの条件から、このガイドに関連する防犯用品を比較できます。</p></div><a class="btn-primary" href={productHref}>関連商品を探す <span>→</span></a></section>
      </div>

      <aside class="side">
        <div class="diagnosis-card"><span>30 SEC CHECK</span><strong>自宅には何が必要？</strong><p>6問で優先対策と商品候補を整理します。</p><a class="btn-primary" href="/diagnosis/">防犯診断をする <span>→</span></a></div>
        <div class="side-links"><strong>場所・条件から探す</strong><a href="/products/?place=entrance">玄関 <span>→</span></a><a href="/products/?place=window">窓 <span>→</span></a><a href="/products/?place=parking">駐車場 <span>→</span></a><a href="/products/?condition=no-drilling">工事不要 <span>→</span></a><a href="/products/?condition=no-wifi">Wi-Fi不要 <span>→</span></a></div>
        <div class="side-policy"><small>UCHIMAMO POLICY</small><p>独自評価と楽天市場レビューを分けて表示し、価格・在庫は販売ページの最新情報を優先します。</p><a href="/about/">選定方針 →</a></div>
      </aside>
    </div>
  </article>
</BaseLayout>
<style>
  .breadcrumb{padding-top:21px;display:flex;gap:8px;align-items:center;color:var(--slate-500);font-size:.6rem}.breadcrumb a:hover{color:var(--blue-700)}.breadcrumb b{font-weight:700;color:var(--slate-700)}
  .article-hero{padding:48px 0 58px;background:#f5f6f4;border-bottom:1px solid var(--slate-200)}.article-narrow{max-width:930px}.meta{display:flex;align-items:center;gap:11px;flex-wrap:wrap;color:var(--slate-500);font-size:.58rem}.meta .category{color:var(--blue-700);font-weight:900}.meta a{margin-left:auto;color:var(--blue-700);font-weight:900}.article-hero h1{font-size:clamp(2.15rem,4.8vw,3.7rem);line-height:1.25;letter-spacing:-.05em;color:var(--navy-950);margin:19px 0 14px}.lead{font-size:.9rem;color:var(--slate-700);max-width:820px}.reader-line{margin-top:25px;padding-top:17px;border-top:1px solid var(--slate-300);display:flex;gap:15px;align-items:baseline}.reader-line small{color:var(--gold-600);font-size:.56rem;font-weight:900;white-space:nowrap}.reader-line strong{font-size:.72rem;color:var(--slate-700)}.conclusion{margin-top:24px;border:1px solid var(--slate-300);border-radius:14px;background:#fff;display:grid;grid-template-columns:120px 1fr;overflow:hidden}.conclusion>span{display:grid;place-items:center;background:var(--navy-950);color:#a9bfd1;font-size:.52rem;font-weight:900;letter-spacing:.12em}.conclusion>div{padding:17px 20px}.conclusion small{display:block;color:var(--slate-500);font-size:.56rem;font-weight:900}.conclusion strong{display:block;font-size:.82rem;line-height:1.75;margin-top:3px;color:var(--navy-950)}
  .article-layout{display:grid;grid-template-columns:minmax(0,1fr) 270px;gap:48px;align-items:start;padding-top:46px}.article-body{max-width:810px}.toc{padding:0 0 30px;margin-bottom:43px;border-bottom:1px solid var(--slate-300);display:grid;grid-template-columns:180px 1fr;gap:20px}.toc>div strong{display:block;color:var(--navy-950);font-size:.75rem;margin-top:3px}.toc ol{margin:0;padding:0;list-style:none}.toc li+li{border-top:1px solid var(--slate-200)}.toc a{display:grid;grid-template-columns:28px 1fr;gap:8px;padding:8px 0;color:var(--slate-600);font-size:.68rem}.toc a span{color:var(--slate-400);font-size:.55rem;font-weight:900}.toc a:hover{color:var(--blue-700)}
  .article-section{position:relative;padding:0 0 52px 58px;scroll-margin-top:105px}.article-section:before{content:"";position:absolute;left:19px;top:42px;bottom:9px;width:1px;background:var(--slate-200)}.section-number{position:absolute;left:0;top:0;width:39px;height:39px;border-radius:50%;border:1px solid var(--slate-300);background:#fff;color:var(--slate-500);display:grid;place-items:center;font-size:.58rem;font-weight:950}.article-section h2{font-size:1.48rem;line-height:1.42;color:var(--navy-950);margin:0 0 16px;letter-spacing:-.03em}.article-section p{font-size:.84rem;color:var(--slate-700);margin:0 0 15px;line-height:1.95}.article-section ul{margin:18px 0;padding:17px 20px 17px 39px;border-left:2px solid var(--navy-900);background:#f3f4f3}.article-section li{font-size:.76rem;color:var(--slate-700);padding:3px 0}
  .source-box{padding:25px 0;margin:2px 0 30px;border-block:1px solid var(--slate-300);display:grid;grid-template-columns:.7fr 1.3fr;gap:36px}.source-box h2{margin:4px 0;color:var(--navy-950);font-size:1.05rem}.source-box p{font-size:.72rem;color:var(--slate-700);margin:0}.source-box a{display:inline-block;color:var(--blue-700);font-size:.66rem;font-weight:900;margin-top:9px}.article-note{padding:18px 20px;background:#f3f4f3;border-radius:11px;margin-bottom:30px}.article-note>span{display:block;color:var(--slate-500);font-size:.5rem;font-weight:900;letter-spacing:.1em}.article-note p{font-size:.64rem;color:var(--slate-600);margin:5px 0}.article-note a{color:var(--blue-700);font-size:.58rem;font-weight:900}.article-cta{background:var(--navy-950);border-radius:17px;padding:27px 29px;color:white;display:flex;align-items:center;justify-content:space-between;gap:25px}.article-cta .eyebrow{color:#99b7d0}.article-cta h2{font-size:1.18rem;margin:4px 0}.article-cta p{font-size:.68rem;color:#a8b8c7;margin:0;max-width:520px}.article-cta .btn-primary{background:#fff;color:var(--navy-950);box-shadow:none;white-space:nowrap}
  .side{position:sticky;top:94px;display:grid;gap:12px}.diagnosis-card,.side-links,.side-policy{background:#fff;border:1px solid var(--slate-200);border-radius:13px;padding:18px}.diagnosis-card>span{font-size:.5rem;font-weight:900;letter-spacing:.11em;color:var(--blue-700)}.diagnosis-card>strong{display:block;font-size:.9rem;color:var(--navy-950);margin:5px 0}.diagnosis-card p{font-size:.64rem;color:var(--slate-500)}.diagnosis-card .btn-primary{width:100%;min-height:40px;font-size:.64rem;padding-inline:8px}.side-links>strong{display:block;font-size:.7rem;color:var(--navy-950);padding-bottom:9px;border-bottom:1px solid var(--slate-200);margin-bottom:4px}.side-links a{display:flex;justify-content:space-between;padding:7px 0;color:var(--slate-600);font-size:.65rem;font-weight:700}.side-links a:hover{color:var(--blue-700)}.side-policy small{color:var(--slate-400);font-size:.48rem;font-weight:900;letter-spacing:.1em}.side-policy p{color:var(--slate-500);font-size:.6rem}.side-policy a{color:var(--blue-700);font-size:.58rem;font-weight:900}
  @media(max-width:880px){.article-layout{grid-template-columns:1fr}.article-body{max-width:none}.side{position:static;grid-template-columns:1fr 1fr}.side-policy{grid-column:1/-1}}
  @media(max-width:640px){.article-hero{padding:34px 0 40px}.meta a{margin-left:0}.article-hero h1{font-size:2.05rem}.reader-line{display:block}.reader-line strong{display:block;margin-top:4px}.conclusion{grid-template-columns:1fr}.conclusion>span{display:block;padding:8px 14px}.article-layout{padding-top:28px;gap:24px}.toc{grid-template-columns:1fr;gap:10px;margin-bottom:34px}.article-section{padding-left:0;padding-bottom:40px}.article-section:before{display:none}.section-number{position:static;margin-bottom:10px}.article-section h2{font-size:1.25rem}.article-section p{font-size:.81rem}.source-box{grid-template-columns:1fr;gap:8px}.article-cta{display:block;padding:23px 20px}.article-cta .btn-primary{margin-top:17px}.side{grid-template-columns:1fr}.side-policy{grid-column:auto}}
</style>
