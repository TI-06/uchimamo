---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { guides } from '../../data/guides';
const featured = guides[0];
const rest = guides.slice(1);
---
<BaseLayout title="家庭防犯ガイド｜ウチマモ" description="工事不要・後付けで始める家庭防犯の選び方を、玄関・窓・駐車場・実家など場所や条件別に整理します。">
  <section class="guide-hero">
    <div class="site-container hero-layout">
      <div><span class="eyebrow">SECURITY JOURNAL</span><h1>防犯用品を買う前に、<br />知っておきたいこと。</h1><p>商品を増やす前に、住まいの弱点と優先順位を知る。ウチマモでは施錠・窓・屋外・通信環境まで、後付け防犯の考え方を整理します。</p></div>
      <div class="guide-count"><small>GUIDE LIBRARY</small><strong>{guides.length}</strong><span>公開ガイド</span><a href="/about/">編集・選定方針 →</a></div>
    </div>
  </section>

  {featured && <section class="featured-section"><div class="site-container"><a class="featured-guide" href={`/guide/${featured.slug}/`}><div class="featured-number">01</div><div class="featured-copy"><span class="chip chip-gold">FEATURED</span><small>{featured.category} ・ {featured.readMinutes}分</small><h2>{featured.title}</h2><p>{featured.description}</p><strong>ガイドを読む →</strong></div><div class="featured-art" aria-hidden="true"><svg viewBox="0 0 260 200"><path d="M35 95 130 25l95 70v78H35V95Z"/><path d="M76 173v-62h48v62M152 105h35v31h-35z"/><path d="m99 78 22 22 43-45"/></svg></div></a></div></section>}

  <section class="section">
    <div class="site-container">
      <div class="guide-heading"><div><span class="eyebrow">ALL GUIDES</span><h2 class="section-title">テーマから読む</h2></div><p>商品紹介だけでなく「そもそも何を確認すべきか」から整理しています。</p></div>
      <div class="guide-grid">
        {rest.map((guide,i) => <article class="guide-card">
          <a class="thumb" href={`/guide/${guide.slug}/`} aria-label={guide.title}><span>{String(i+2).padStart(2,'0')}</span><small>{guide.category}</small></a>
          <div class="body"><div class="meta"><span>{guide.category}</span><small>{guide.readMinutes}分</small></div><h2><a href={`/guide/${guide.slug}/`}>{guide.title}</a></h2><p>{guide.description}</p><a class="read" href={`/guide/${guide.slug}/`}>続きを読む <span>→</span></a></div>
        </article>)}
      </div>
    </div>
  </section>

  <section class="section diagnosis-section"><div class="site-container diagnosis-link"><div><span class="eyebrow">QUICK CHECK</span><h2>読む前に、自宅の条件を整理する。</h2><p>住まい・設置場所・電源・Wi-Fi・工事可否・予算の6問で、優先対策と商品候補を確認できます。</p></div><a class="btn-primary" href="/diagnosis/">30秒で防犯診断 <span>→</span></a></div></section>
</BaseLayout>
<style>
  .guide-hero{padding:76px 0 62px;background:#f5f6f4;border-bottom:1px solid var(--slate-200)}.hero-layout{display:flex;align-items:end;justify-content:space-between;gap:50px}.guide-hero h1{font-size:clamp(2.45rem,5.2vw,4.2rem);line-height:1.1;letter-spacing:-.055em;color:var(--navy-950);margin:10px 0 16px}.guide-hero p{color:var(--slate-700);max-width:720px;margin:0}.guide-count{min-width:210px;border-left:1px solid var(--slate-300);padding-left:28px}.guide-count small{display:block;color:var(--slate-400);font-size:.5rem;font-weight:900;letter-spacing:.13em}.guide-count strong{display:block;font-size:3rem;line-height:1;color:var(--navy-950);margin-top:8px}.guide-count span{display:block;color:var(--slate-500);font-size:.62rem}.guide-count a{display:inline-block;color:var(--blue-700);font-size:.58rem;font-weight:900;margin-top:13px}
  .featured-section{padding:42px 0 12px;background:#fff}.featured-guide{position:relative;overflow:hidden;display:grid;grid-template-columns:80px 1.2fr .8fr;gap:24px;align-items:center;min-height:300px;background:var(--navy-950);border-radius:18px;padding:34px 40px;color:#fff}.featured-number{align-self:start;color:#61778b;font-size:.72rem;font-weight:900;letter-spacing:.1em}.featured-copy>small{display:inline-block;color:#9fb1c3;font-size:.58rem;margin-left:8px}.featured-copy h2{font-size:clamp(1.55rem,3vw,2.25rem);line-height:1.35;letter-spacing:-.035em;margin:12px 0}.featured-copy p{color:#aab9c7;font-size:.76rem;max-width:620px}.featured-copy>strong{display:inline-block;margin-top:11px;font-size:.66rem}.featured-art{display:grid;place-items:center}.featured-art svg{width:100%;max-width:280px;fill:none;stroke:#8fa7bb;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;opacity:.75}
  .guide-heading{display:flex;justify-content:space-between;align-items:end;gap:30px;margin-bottom:24px}.guide-heading>p{max-width:500px;color:var(--slate-500);font-size:.68rem;margin:0}.guide-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.guide-card{overflow:hidden;background:#fff;border:1px solid var(--slate-200);border-radius:14px;transition:.18s ease}.guide-card:hover{transform:translateY(-2px);border-color:#bcc5cd;box-shadow:var(--shadow-sm)}.thumb{height:105px;background:#f1f3f3;display:flex;justify-content:space-between;align-items:end;padding:15px;color:var(--navy-900);border-bottom:1px solid var(--slate-200)}.thumb>span{font-size:1.8rem;font-weight:950;color:#c2c9cf;line-height:1}.thumb small{font-size:.56rem;font-weight:900;color:var(--slate-500)}.body{padding:17px}.meta{display:flex;align-items:center;justify-content:space-between;gap:8px}.meta span{color:var(--blue-700);font-size:.54rem;font-weight:900}.meta small{color:var(--slate-400);font-size:.54rem}.body h2{font-size:.93rem;line-height:1.55;margin:9px 0 7px;color:var(--navy-950)}.body h2 a:hover{color:var(--blue-700)}.body p{font-size:.68rem;color:var(--slate-500);margin:0;min-height:4.5em}.read{display:inline-flex;align-items:center;gap:7px;margin-top:14px;color:var(--blue-700);font-size:.62rem;font-weight:900}.diagnosis-section{padding-top:18px}.diagnosis-link{background:var(--navy-950);border-radius:18px;padding:32px 36px;display:flex;align-items:center;justify-content:space-between;gap:30px;color:#fff}.diagnosis-link .eyebrow{color:#9bb9d2}.diagnosis-link h2{font-size:1.5rem;margin:4px 0}.diagnosis-link p{color:#a9b8c7;font-size:.72rem;margin:0;max-width:680px}.diagnosis-link .btn-primary{background:#fff;color:var(--navy-950);box-shadow:none;white-space:nowrap}
  @media(max-width:900px){.guide-grid{grid-template-columns:repeat(2,1fr)}.featured-guide{grid-template-columns:55px 1fr}.featured-art{display:none}}
  @media(max-width:640px){.guide-hero{padding:44px 0}.hero-layout{display:block}.guide-count{margin-top:26px;padding:17px 0 0;border-left:0;border-top:1px solid var(--slate-300)}.guide-count strong{font-size:2rem}.featured-section{padding-top:24px}.featured-guide{grid-template-columns:1fr;padding:24px 20px;gap:10px}.featured-number{display:none}.featured-copy h2{font-size:1.45rem}.guide-heading{display:block}.guide-heading>p{margin-top:8px}.guide-grid{grid-template-columns:1fr}.body p{min-height:0}.diagnosis-link{display:block;padding:25px 20px}.diagnosis-link .btn-primary{margin-top:17px}}
</style>
