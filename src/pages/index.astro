---
import '../styles/home.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import productsJson from '../data/products.json';
import cacheJson from '../data/rakuten-cache.json';
import type { Product } from '../types/product';
import type { RakutenCacheItem } from '../lib/rakuten';

const products = productsJson as Product[];
const cache = cacheJson as Record<string, RakutenCacheItem>;
const places = [
  { label:'玄関', slug:'entrance', desc:'スマートロック・ドア周り', icon:'<svg viewBox="0 0 24 24"><path d="M4 10.5 12 4l8 6.5V20H4v-9.5Z"/><path d="M9 20v-7h6v7"/></svg>' },
  { label:'窓', slug:'window', desc:'開閉センサー・補助錠', icon:'<svg viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="16" rx="1"/><path d="M12 4v16M4 12h16"/></svg>' },
  { label:'駐車場', slug:'parking', desc:'屋外カメラ・ライト', icon:'<svg viewBox="0 0 24 24"><path d="M4 15h16l-1.5-5H5.5L4 15Z"/><path d="M6 15v3M18 15v3M7 10l1.5-3h7L17 10"/></svg>' },
  { label:'庭', slug:'garden', desc:'カメラ・人感ライト', icon:'<svg viewBox="0 0 24 24"><path d="M12 20v-9M12 13c-4 0-6-2.5-6-6 4 0 6 2.5 6 6ZM12 16c4 0 6-2.2 6-5.5-4 0-6 2.2-6 5.5Z"/></svg>' },
  { label:'勝手口', slug:'backdoor', desc:'センサー・カメラ', icon:'<svg viewBox="0 0 24 24"><path d="M6 20V5l12-2v17H6Z"/><circle cx="15" cy="12" r=".8" fill="currentColor" stroke="none"/></svg>' },
  { label:'室内', slug:'indoor', desc:'見守り・異常検知', icon:'<svg viewBox="0 0 24 24"><path d="M3 12c2.4-3.3 5.4-5 9-5s6.6 1.7 9 5c-2.4 3.3-5.4 5-9 5s-6.6-1.7-9-5Z"/><circle cx="12" cy="12" r="2.5"/></svg>' }
];
const conditions = [['工事・穴あけ不要','no-drilling'],['Wi-Fi不要','no-wifi'],['コンセント電源不要','no-power'],['月額不要','no-monthly-fee'],['ソーラー','solar']];
const pickupIds = ['switchbot-lock-ultra','tapo-outdoor-battery-camera','window-sensor'];
const pickupProducts = pickupIds.map((id) => products.find((item) => item.id === id)).filter((item): item is Product => Boolean(item));
const latestCheckedAt = Object.values(cache).map((item) => item.fetchedAt).filter(Boolean).sort().at(-1);
const latestCheckedLabel = latestCheckedAt ? new Intl.DateTimeFormat('ja-JP', { year:'numeric', month:'long', day:'numeric' }).format(new Date(latestCheckedAt)) : '確認中';
---
<BaseLayout
  title="ウチマモ｜工事なしで始める、わが家の防犯"
  description="30秒診断、条件検索、3商品比較から、自分の家に合う工事不要・後付け防犯を選べる家庭防犯サービス。"
>
  <section class="home-hero">
    <div class="site-container hero-grid">
      <div class="hero-copy">
        <div class="hero-badge"><span></span> 工事不要・後付け防犯に特化</div>
        <h1>家の防犯、<br /><em>何から始めればいい？</em></h1>
        <p class="hero-lead">住まい・守りたい場所・Wi-Fi・電源・予算。6つの質問に答えるだけで、あなたの家で優先したい対策と商品候補を整理します。</p>
        <div class="hero-actions">
          <a class="btn-primary hero-primary" href="/diagnosis/">30秒で防犯診断 <span>→</span></a>
          <a class="btn-secondary" href="/products/">商品を探す</a>
        </div>
        <div class="hero-proof"><span>登録不要</span><span>完全無料</span><span>広告単価で診断順位を変えません</span></div>
      </div>

      <div class="diagnosis-preview" aria-label="30秒防犯診断の結果イメージ">
        <div class="preview-head">
          <div><small>UCHIMAMO QUICK CHECK</small><strong>30秒診断でわかること</strong></div>
          <span>入力は6問</span>
        </div>
        <div class="preview-steps">
          <div class="preview-step">
            <div><span>01 住まい</span><small>住居タイプ</small></div>
            <strong>戸建て</strong>
          </div>
          <div class="preview-step">
            <div><span>02 気になる場所</span><small>複数選択OK</small></div>
            <div class="preview-chips"><b>玄関</b><b>駐車場</b></div>
          </div>
          <div class="preview-step">
            <div><span>03 設置条件</span><small>工事・維持費</small></div>
            <div class="preview-chips"><b>穴あけNG</b><b>月額なし</b></div>
          </div>
        </div>
        <div class="preview-result">
          <div class="result-kicker"><span>RESULT PREVIEW</span><i>サンプル</i></div>
          <h2>あなたなら、まずこの3対策</h2>
          <ol>
            <li><span>01</span><div><strong>玄関を後付けスマートロック化</strong><small>穴あけなしで施錠管理を強化</small></div></li>
            <li><span>02</span><div><strong>駐車場にバッテリーカメラ</strong><small>電源工事を抑えて屋外を見守る</small></div></li>
            <li><span>03</span><div><strong>死角へセンサーライト</strong><small>月額不要で夜間の抑止を追加</small></div></li>
          </ol>
          <a href="/diagnosis/">30秒診断を始める <span>→</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="quick-start">
    <div class="site-container quick-grid">
      <a href="/diagnosis/" class="quick-card quick-primary">
        <span class="quick-number">01</span><small>DIAGNOSIS</small><strong>30秒診断</strong><p>何を買えばいいか分からない人へ。住まいから優先順位を整理。</p><b>診断する →</b>
      </a>
      <a href="/products/" class="quick-card">
        <span class="quick-number">02</span><small>FINDER</small><strong>条件から探す</strong><p>工事不要・Wi-Fi不要・月額なしなど、設置条件から絞り込み。</p><b>商品を探す →</b>
      </a>
      <a href="/compare/" class="quick-card">
        <span class="quick-number">03</span><small>COMPARE</small><strong>3商品を比較</strong><p>価格、設置、通信、維持費の違いを最大3商品で横並び比較。</p><b>比較する →</b>
      </a>
    </div>
  </section>

  <section class="trust-strip">
    <div class="site-container trust-grid">
      <div><small>CATALOG</small><strong>{products.length}商品を比較対象</strong><span>カメラ・鍵・センサーなど</span></div>
      <div><small>UPDATED</small><strong>{latestCheckedLabel}</strong><span>楽天商品情報を定期確認</span></div>
      <div><small>TRANSPARENT</small><strong>評価軸を公開</strong><a href="/about/">評価方法を見る →</a></div>
      <div><small>PR POLICY</small><strong>広告掲載方針を明示</strong><a href="/affiliate-policy/">掲載方針を見る →</a></div>
    </div>
  </section>

  <section class="section home-place-section">
    <div class="site-container">
      <div class="section-head"><div><span class="eyebrow">BY PLACE</span><h2 class="section-title">守りたい場所から探す</h2><p class="section-lead">商品名を知らなくても大丈夫。気になる場所から、必要な対策と対応商品を逆引きできます。</p></div></div>
      <div class="place-grid">
        {places.map((place) => <a class="place-card" href={`/products/?place=${place.slug}`}><span class="place-icon" aria-hidden="true" set:html={place.icon}></span><div><strong>{place.label}</strong><small>{place.desc}</small></div><b>→</b></a>)}
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="site-container condition-layout">
      <div class="condition-copy"><span class="eyebrow">BY CONDITION</span><h2 class="section-title">家の条件に合うものだけ。</h2><p class="section-lead">「壁に穴を開けたくない」「Wi-Fiがない」「月額を払いたくない」。実際の住まいで譲れない条件から候補を絞れます。</p><a class="editorial-link" href="/guide/">設置条件の考え方を読む →</a></div>
      <div class="condition-grid">{conditions.map(([label,key],i) => <a href={`/products/?condition=${key}`}><span>{String(i+1).padStart(2,'0')}</span><strong>{label}</strong><small>対応商品を見る →</small></a>)}</div>
    </div>
  </section>

  <section class="section pickup-section">
    <div class="site-container">
      <div class="product-heading"><div><span class="eyebrow">EDITOR'S PICK</span><h2 class="section-title">場所別に、まず比較したい3商品</h2><p class="section-lead">玄関・屋外・窓。家の防犯で優先しやすい3つの場所から、代表候補を1商品ずつ選んでいます。</p></div><a href="/products/">すべての商品を見る →</a></div>
      <div class="pickup-labels"><span>玄関</span><span>屋外</span><span>窓</span></div>
      <div class="grid-3">{pickupProducts.map((product) => <ProductCard product={product} rakuten={cache[product.id]} />)}</div>
      <div class="pickup-note"><span>商品情報: {latestCheckedLabel}確認</span><a href="/about/">ウチマモの評価基準を見る →</a></div>
    </div>
  </section>

  <section class="section editorial-section">
    <div class="site-container editorial-layout">
      <div><span class="eyebrow">SECURITY GUIDE</span><h2 class="section-title">商品を買う前に、対策の順番を知る。</h2><p class="section-lead">防犯用品は高いものを買えば安心、ではありません。玄関・窓・屋外など、侵入経路と設置条件から順番を決めることが大切です。</p><a class="btn-secondary" href="/guide/">防犯ガイドを読む</a></div>
      <div class="guide-list">
        <a href="/guide/house-security-diy-order/"><span>01</span><div><small>戸建て</small><strong>玄関・窓・駐車場の優先順位</strong></div><b>→</b></a>
        <a href="/guide/outdoor-camera-no-drilling/"><span>02</span><div><small>屋外カメラ</small><strong>穴あけ不要で設置する考え方</strong></div><b>→</b></a>
        <a href="/guide/security-camera-no-wifi/"><span>03</span><div><small>通信</small><strong>Wi-Fiなしで使えるカメラの選び方</strong></div><b>→</b></a>
      </div>
    </div>
  </section>

  <section class="section diagnose-band">
    <div class="site-container diagnose-inner"><div><span>NOT SURE WHERE TO START?</span><h2>あなたの家に必要な対策を、30秒で整理。</h2><p>商品名を知らなくても大丈夫。住まいの条件から候補と優先順位を出します。</p></div><a class="btn-primary" href="/diagnosis/">無料で防犯診断 <span>→</span></a></div>
  </section>
</BaseLayout>
