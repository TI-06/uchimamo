---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import productsJson from '../data/products.json';
import cacheJson from '../data/rakuten-cache.json';
import type { Product } from '../types/product';
import type { RakutenCacheItem } from '../lib/rakuten';

const products = productsJson as Product[];
const cache = cacheJson as Record<string, RakutenCacheItem>;
const places = [
  ['玄関','entrance','スマートロック・ドア周り'], ['窓','window','開閉センサー・補助錠'], ['駐車場','parking','屋外カメラ・ライト'],
  ['庭','garden','カメラ・人感ライト'], ['勝手口','backdoor','センサー・カメラ'], ['室内','indoor','見守り・異常検知']
];
const conditions = [['工事不要','no-drilling'],['Wi-Fi不要','no-wifi'],['電源不要','no-power'],['月額不要','no-monthly-fee'],['ソーラー','solar']];
---
<BaseLayout>
  <section class="hero">
    <div class="site-container hero-grid">
      <div class="hero-copy">
        <div class="hero-badge"><span></span> 工事不要・後付け防犯に特化</div>
        <h1>家の防犯、<br /><em>何から始めればいい？</em></h1>
        <p>住まい・守りたい場所・Wi-Fi・電源・予算。<br class="desktop" />6つの質問から、あなたの家に合う防犯対策を整理します。</p>
        <div class="hero-actions"><a class="btn-primary hero-btn" href="/diagnosis/">30秒で防犯診断をする <span>→</span></a><a class="btn-secondary hero-btn" href="/products/">商品から探す</a></div>
        <div class="hero-proof"><span>✓ 登録不要</span><span>✓ 完全無料</span><span>✓ 商品を横断比較</span></div>
      </div>
      <div class="security-panel" aria-label="防犯診断のイメージ">
        <div class="panel-head"><div><small>UCHIMAMO SECURITY CHECK</small><strong>わが家の防犯状況</strong></div><span class="live"><i></i> CHECK</span></div>
        <div class="house-map">
          <div class="house"><div class="roof"></div><div class="door"></div><div class="window w1"></div><div class="window w2"></div></div>
          <span class="pin p1">玄関 <b>!</b></span><span class="pin p2">窓 <b>✓</b></span><span class="pin p3">駐車場 <b>!</b></span>
        </div>
        <div class="score-row"><div class="score-ring"><strong>62</strong><small>/100</small></div><div><small>現在の目安</small><strong>まず玄関から対策</strong><p>工事不要のスマートロック候補があります</p></div></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="site-container">
      <div class="section-head"><div><span class="eyebrow">BY PLACE</span><h2 class="section-title">守りたい場所から探す</h2><p class="section-lead">「どの商品がいいか」ではなく、気になる場所から必要な対策を逆引きできます。</p></div></div>
      <div class="place-grid">
        {places.map(([label,slug,desc], i) => <a class="place-card" href={`/products/?place=${slug}`}><span class="place-icon">{['⌂','▣','▰','♧','↳','◉'][i]}</span><div><strong>{label}</strong><small>{desc}</small></div><b>→</b></a>)}
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="site-container condition-layout">
      <div><span class="eyebrow">BY CONDITION</span><h2 class="section-title">設置条件から絞り込む</h2><p class="section-lead">「壁に穴を開けたくない」「Wi-Fiがない」といった現実的な条件から候補を絞ります。</p></div>
      <div class="condition-grid">{conditions.map(([label,key]) => <a href={`/products/?condition=${key}`}><span>✓</span><strong>{label}</strong><small>対応商品を見る →</small></a>)}</div>
    </div>
  </section>

  <section class="section">
    <div class="site-container">
      <div class="product-heading"><div><span class="eyebrow">PICK UP</span><h2 class="section-title">まず比較したい防犯アイテム</h2></div><a href="/products/">すべての商品を見る →</a></div>
      <div class="grid-3">{products.slice(0,3).map((product) => <ProductCard product={product} rakuten={cache[product.id]} />)}</div>
    </div>
  </section>

  <section class="section diagnose-band">
    <div class="site-container diagnose-inner"><div><span>迷ったらここから</span><h2>あなたの家に必要な対策を、30秒で整理。</h2><p>商品名を知らなくても大丈夫。住まいの条件から候補を出します。</p></div><a class="btn-primary" href="/diagnosis/">無料で防犯診断する →</a></div>
  </section>
</BaseLayout>

<style>
  .hero{padding:76px 0 70px;overflow:hidden}.hero-grid{display:grid;grid-template-columns:1.03fr .97fr;gap:66px;align-items:center}.hero-badge{display:inline-flex;align-items:center;gap:8px;padding:7px 12px;border-radius:999px;background:var(--blue-100);color:#0e65ca;font-size:.75rem;font-weight:900}.hero-badge span{width:7px;height:7px;border-radius:50%;background:var(--blue-600);box-shadow:0 0 0 5px rgba(22,119,255,.1)}.hero h1{font-size:clamp(2.65rem,5vw,4.6rem);line-height:1.08;letter-spacing:-.055em;margin:20px 0;color:var(--navy-950)}.hero h1 em{font-style:normal;color:var(--blue-600)}.hero-copy>p{font-size:1.05rem;color:var(--slate-700);margin:0 0 28px}.hero-actions{display:flex;gap:10px}.hero-btn{min-height:56px;padding-inline:25px}.hero-proof{display:flex;gap:18px;margin-top:19px;color:var(--slate-500);font-size:.73rem;font-weight:800}.security-panel{position:relative;background:rgba(255,255,255,.92);border:1px solid #dbe7f4;border-radius:25px;padding:22px;box-shadow:0 28px 70px rgba(11,31,54,.14)}.security-panel:before{content:"";position:absolute;inset:-40px -50px;z-index:-1;background:radial-gradient(circle,#dceeff 0,rgba(220,238,255,0) 65%)}.panel-head{display:flex;justify-content:space-between;align-items:center}.panel-head small{display:block;color:var(--slate-500);font-size:.58rem;font-weight:900;letter-spacing:.12em}.panel-head strong{display:block;color:var(--navy-950);margin-top:3px}.live{font-size:.65rem;font-weight:900;color:var(--green-600);background:var(--green-100);padding:6px 9px;border-radius:999px}.live i{display:inline-block;width:6px;height:6px;border-radius:50%;background:#21a876;margin-right:5px}.house-map{height:260px;margin:20px 0 16px;border-radius:18px;background:linear-gradient(145deg,#eef6ff,#f9fcff);position:relative;overflow:hidden;border:1px solid #e2edf7}.house{position:absolute;width:195px;height:130px;left:50%;top:78px;transform:translateX(-50%);background:white;border:2px solid #b9cee2;border-radius:3px}.roof{position:absolute;width:145px;height:145px;background:white;border-left:2px solid #b9cee2;border-top:2px solid #b9cee2;transform:rotate(45deg);left:23px;top:-70px}.door{position:absolute;width:42px;height:74px;background:#deebf6;border:2px solid #9fb9d1;bottom:0;left:76px}.window{position:absolute;width:36px;height:32px;background:#dff3ff;border:2px solid #9fb9d1;top:42px}.w1{left:20px}.w2{right:20px}.pin{position:absolute;background:white;border:1px solid #d5e2ef;border-radius:9px;padding:6px 8px;font-size:.65rem;font-weight:800;color:var(--slate-700);box-shadow:var(--shadow-sm)}.pin b{display:inline-grid;place-items:center;width:18px;height:18px;border-radius:50%;background:var(--orange-100);color:var(--orange-600);margin-left:3px}.p1{left:54%;top:175px}.p2{left:13%;top:110px}.p2 b{background:var(--green-100);color:var(--green-600)}.p3{right:7%;bottom:16px}.score-row{display:grid;grid-template-columns:78px 1fr;gap:16px;align-items:center}.score-ring{width:72px;height:72px;border:7px solid #e7f1fb;border-top-color:var(--blue-600);border-right-color:var(--blue-600);border-radius:50%;display:grid;place-items:center;position:relative}.score-ring strong{font-size:1.25rem;color:var(--navy-950)}.score-ring small{position:absolute;bottom:10px;font-size:.52rem;color:var(--slate-500)}.score-row>div:last-child small{font-size:.65rem;color:var(--slate-500)}.score-row>div:last-child strong{display:block;color:var(--navy-950)}.score-row p{font-size:.68rem;color:var(--slate-500);margin:2px 0 0}.section-head{display:flex;justify-content:space-between;gap:24px;margin-bottom:28px}.place-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.place-card{display:flex;align-items:center;gap:13px;padding:18px;background:white;border:1px solid var(--slate-200);border-radius:16px;transition:.18s ease}.place-card:hover{border-color:#a9cbed;transform:translateY(-2px);box-shadow:var(--shadow-sm)}.place-icon{width:48px;height:48px;display:grid;place-items:center;background:var(--blue-100);border-radius:13px;color:var(--blue-600);font-size:1.15rem}.place-card strong{display:block;color:var(--navy-950)}.place-card small{display:block;color:var(--slate-500);font-size:.68rem;margin-top:2px}.place-card>b{margin-left:auto;color:var(--blue-600)}.condition-layout{display:grid;grid-template-columns:.8fr 1.2fr;gap:60px;align-items:center}.condition-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.condition-grid a{display:grid;grid-template-columns:32px 1fr;align-items:center;gap:8px;background:white;border:1px solid var(--slate-200);border-radius:14px;padding:14px}.condition-grid a>span{grid-row:1/3;width:30px;height:30px;display:grid;place-items:center;border-radius:9px;background:var(--green-100);color:var(--green-600);font-weight:900}.condition-grid strong{font-size:.84rem}.condition-grid small{font-size:.65rem;color:var(--slate-500)}.product-heading{display:flex;align-items:end;justify-content:space-between;margin-bottom:26px}.product-heading>a{color:var(--blue-600);font-size:.8rem;font-weight:900}.diagnose-band{padding:36px 0}.diagnose-inner{background:linear-gradient(135deg,var(--navy-950),#123d64);border-radius:24px;padding:34px 38px;color:white;display:flex;align-items:center;justify-content:space-between;gap:28px;box-shadow:var(--shadow-md)}.diagnose-inner span{color:#8cc4ff;font-size:.7rem;font-weight:900;letter-spacing:.08em}.diagnose-inner h2{margin:4px 0;font-size:1.55rem}.diagnose-inner p{margin:0;color:#b7c9dc;font-size:.82rem}.diagnose-inner .btn-primary{white-space:nowrap}
  @media(max-width:900px){.hero{padding-top:50px}.hero-grid,.condition-layout{grid-template-columns:1fr}.hero-grid{gap:42px}.place-grid{grid-template-columns:repeat(2,1fr)}.condition-layout{gap:28px}.security-panel{max-width:600px;width:100%;margin:auto}}
  @media(max-width:640px){.hero{padding:36px 0 44px}.hero h1{font-size:2.55rem}.hero-copy>p{font-size:.9rem}.desktop{display:none}.hero-actions{display:grid}.hero-proof{gap:10px;flex-wrap:wrap}.security-panel{padding:15px;border-radius:20px}.house-map{height:220px}.house{transform:translateX(-50%) scale(.85)}.place-grid{grid-template-columns:1fr 1fr}.place-card{padding:13px;gap:9px}.place-icon{width:40px;height:40px}.place-card small{display:none}.condition-grid{grid-template-columns:1fr}.product-heading{align-items:start;gap:15px}.product-heading>a{white-space:nowrap;margin-top:10px}.diagnose-inner{padding:26px 22px;display:block}.diagnose-inner .btn-primary{margin-top:20px}}
</style>
