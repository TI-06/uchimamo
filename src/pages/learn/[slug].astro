---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { seoArticles, type SeoArticle } from '../../data/seo-articles';
import { absoluteUrl, normalizeSiteUrl } from '../../lib/seo';

export function getStaticPaths() {
  return seoArticles.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

interface Props { article: SeoArticle }
const { article } = Astro.props;
const base = normalizeSiteUrl(import.meta.env.PUBLIC_SITE_URL || 'https://uchimamo.pages.dev');
const articleUrl = absoluteUrl(base, `/learn/${article.slug}/`);
const productHref = article.productQuery ? `/products/?${article.productQuery}` : '/products/';
const relatedSecurityHref = article.securitySlug ? `/security/${article.securitySlug}/` : '/security/';
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      '@id': `${articleUrl}#article`,
      headline: article.title,
      description: article.description,
      url: articleUrl,
      mainEntityOfPage: articleUrl,
      inLanguage: 'ja',
      author: { '@type': 'Organization', name: 'ウチマモ編集部', url: `${base}/about/` },
      publisher: { '@type': 'Organization', name: 'ウチマモ', url: base },
      datePublished: article.updatedAt,
      dateModified: article.updatedAt
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'TOP', item: `${base}/` },
        { '@type': 'ListItem', position: 2, name: '家庭防犯の選び方', item: `${base}/learn/` },
        { '@type': 'ListItem', position: 3, name: article.title, item: articleUrl }
      ]
    }
  ]
};
---
<BaseLayout title={`${article.title}｜ウチマモ`} description={article.description} ogType="article">
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(structuredData)} /></Fragment>

  <div class="site-container breadcrumb"><a href="/">TOP</a><span>›</span><a href="/learn/">家庭防犯の選び方</a><span>›</span><b>{article.category}</b></div>

  <article>
    <header class="article-hero">
      <div class="site-container article-narrow">
        <div class="meta"><span class="category">{article.category}</span><span>{article.readMinutes}分で読めます</span><time datetime={article.updatedAt}>更新 {article.updatedAt.replaceAll('-', '.')}</time><a href="/about/">編集方針</a></div>
        <h1>{article.title}</h1>
        <p class="lead">{article.description}</p>
        <div class="conclusion"><span>CONCLUSION</span><div><small>先に結論</small><strong>{article.conclusion}</strong></div></div>
      </div>
    </header>

    <div class="site-container article-layout">
      <div class="article-body">
        <aside class="toc">
          <div><span class="eyebrow">CONTENTS</span><strong>この記事で確認すること</strong></div>
          <ol>{article.sections.map((section, index) => <li><a href={`#section-${index + 1}`}><span>{String(index + 1).padStart(2, '0')}</span>{section.heading}</a></li>)}</ol>
        </aside>

        {article.sections.map((section, index) => (
          <section class="article-section" id={`section-${index + 1}`}>
            <div class="section-number">{String(index + 1).padStart(2, '0')}</div>
            <h2>{section.heading}</h2>
            {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            {section.bullets && <ul>{section.bullets.map((item) => <li>{item}</li>)}</ul>}
          </section>
        ))}

        <section class="source-box">
          <div><span class="eyebrow">PUBLIC SOURCE</span><h2>公的情報を確認</h2></div>
          <div><p>家庭防犯は商品購入だけで完結しません。施錠、窓やドアの状態、建物周囲の見通しなど基本対策も含めて判断してください。</p><a href={article.source.url} target="_blank" rel="noopener noreferrer">{article.source.label} ↗</a></div>
        </section>

        <section class="editorial-note"><span>EDITORIAL / PR POLICY</span><p>本記事は商品を一律に推奨するものではなく、設置条件や運用方法を整理するための情報です。関連商品へのリンクにはアフィリエイト広告を含む場合があります。</p><a href="/affiliate-policy/">広告掲載方針を見る →</a></section>

        <section class="article-cta">
          <div><span class="eyebrow">NEXT ACTION</span><h2>自宅の条件に合う商品へ絞り込む</h2><p>記事で必要な条件が整理できたら、仕様確認済みの商品を比較できます。</p></div>
          <div class="cta-links"><a class="btn-primary" href={productHref}>関連商品を見る <span>→</span></a><a href={relatedSecurityHref}>条件別の選び方を見る →</a></div>
        </section>
      </div>

      <aside class="side">
        <div class="side-card primary"><span>30 SEC CHECK</span><strong>自宅には何が必要？</strong><p>6問で優先したい対策と商品候補を整理します。</p><a class="btn-primary" href="/diagnosis/">30秒防犯診断 <span>→</span></a></div>
        <div class="side-card"><strong>次に読む</strong><a href="/learn/">悩み別の記事一覧 <span>→</span></a><a href="/security/">条件別の防犯テーマ <span>→</span></a><a href="/guide/">基礎防犯ガイド <span>→</span></a><a href="/products/">防犯用品を探す <span>→</span></a></div>
      </aside>
    </div>
  </article>
</BaseLayout>
<style>
  .breadcrumb{padding-top:21px;display:flex;gap:8px;align-items:center;color:var(--slate-500);font-size:.6rem}.breadcrumb a:hover{color:var(--blue-700)}.breadcrumb b{font-weight:700;color:var(--slate-700)}
  .article-hero{padding:48px 0 58px;background:linear-gradient(135deg,#f5f6f4,#eef2f4);border-bottom:1px solid var(--slate-200)}.article-narrow{max-width:930px}.meta{display:flex;align-items:center;gap:11px;flex-wrap:wrap;color:var(--slate-500);font-size:.58rem}.meta .category{color:var(--blue-700);font-weight:900}.meta a{margin-left:auto;color:var(--blue-700);font-weight:900}.article-hero h1{font-size:clamp(2.15rem,4.8vw,3.65rem);line-height:1.24;letter-spacing:-.05em;color:var(--navy-950);margin:19px 0 14px}.lead{font-size:.9rem;color:var(--slate-700);max-width:820px;line-height:1.9}.conclusion{margin-top:25px;border:1px solid var(--slate-300);border-radius:14px;background:#fff;display:grid;grid-template-columns:120px 1fr;overflow:hidden}.conclusion>span{display:grid;place-items:center;background:var(--navy-950);color:#a9bfd1;font-size:.52rem;font-weight:900;letter-spacing:.12em}.conclusion>div{padding:17px 20px}.conclusion small{display:block;color:var(--slate-500);font-size:.56rem;font-weight:900}.conclusion strong{display:block;font-size:.82rem;line-height:1.75;margin-top:3px;color:var(--navy-950)}
  .article-layout{display:grid;grid-template-columns:minmax(0,1fr) 270px;gap:48px;align-items:start;padding-top:46px}.article-body{max-width:810px}.toc{padding:0 0 30px;margin-bottom:43px;border-bottom:1px solid var(--slate-300);display:grid;grid-template-columns:180px 1fr;gap:20px}.toc>div strong{display:block;color:var(--navy-950);font-size:.75rem;margin-top:3px}.toc ol{margin:0;padding:0;list-style:none}.toc li+li{border-top:1px solid var(--slate-200)}.toc a{display:grid;grid-template-columns:28px 1fr;gap:8px;padding:8px 0;color:var(--slate-600);font-size:.68rem}.toc a span{color:var(--slate-400);font-size:.55rem;font-weight:900}.toc a:hover{color:var(--blue-700)}
  .article-section{position:relative;padding:0 0 52px 58px;scroll-margin-top:105px}.article-section:before{content:"";position:absolute;left:19px;top:42px;bottom:9px;width:1px;background:var(--slate-200)}.section-number{position:absolute;left:0;top:0;width:39px;height:39px;border-radius:50%;border:1px solid var(--slate-300);background:#fff;color:var(--slate-500);display:grid;place-items:center;font-size:.58rem;font-weight:950}.article-section h2{font-size:1.48rem;line-height:1.42;color:var(--navy-950);margin:0 0 16px;letter-spacing:-.03em}.article-section p{font-size:.84rem;color:var(--slate-700);margin:0 0 15px;line-height:1.95}.article-section ul{margin:18px 0;padding:17px 20px 17px 39px;border-left:2px solid var(--navy-900);background:#f3f4f3}.article-section li{font-size:.76rem;color:var(--slate-700);padding:3px 0}
  .source-box{padding:25px 0;margin:2px 0 30px;border-block:1px solid var(--slate-300);display:grid;grid-template-columns:.7fr 1.3fr;gap:36px}.source-box h2{margin:4px 0;color:var(--navy-950);font-size:1.05rem}.source-box p{font-size:.72rem;color:var(--slate-700);margin:0}.source-box a{display:inline-block;color:var(--blue-700);font-size:.66rem;font-weight:900;margin-top:9px}.editorial-note{padding:18px 20px;background:#f3f4f3;border-radius:11px;margin-bottom:30px}.editorial-note>span{display:block;color:var(--slate-500);font-size:.5rem;font-weight:900;letter-spacing:.1em}.editorial-note p{font-size:.64rem;color:var(--slate-600);margin:5px 0}.editorial-note a{color:var(--blue-700);font-size:.58rem;font-weight:900}.article-cta{background:var(--navy-950);border-radius:17px;padding:27px 29px;color:white;display:flex;align-items:center;justify-content:space-between;gap:25px}.article-cta .eyebrow{color:#99b7d0}.article-cta h2{font-size:1.18rem;margin:4px 0}.article-cta p{font-size:.68rem;color:#a8b8c7;margin:0;max-width:510px}.cta-links{display:grid;gap:9px;text-align:right}.cta-links>a:not(.btn-primary){color:#d8e1e9;font-size:.6rem;font-weight:850}.article-cta .btn-primary{background:#fff;color:var(--navy-950);box-shadow:none;white-space:nowrap}
  .side{position:sticky;top:94px;display:grid;gap:12px}.side-card{background:#fff;border:1px solid var(--slate-200);border-radius:13px;padding:18px}.side-card>span{font-size:.5rem;font-weight:900;letter-spacing:.11em;color:var(--blue-700)}.side-card>strong{display:block;font-size:.82rem;color:var(--navy-950);margin:4px 0 8px}.side-card p{font-size:.64rem;color:var(--slate-500)}.side-card .btn-primary{width:100%;min-height:40px;font-size:.64rem;padding-inline:8px}.side-card>a:not(.btn-primary){display:flex;justify-content:space-between;padding:7px 0;color:var(--slate-600);font-size:.65rem;font-weight:700;border-top:1px solid var(--slate-100)}.side-card>a:hover{color:var(--blue-700)}
  @media(max-width:880px){.article-layout{grid-template-columns:1fr}.article-body{max-width:none}.side{position:static;grid-template-columns:1fr 1fr}}
  @media(max-width:640px){.article-hero{padding:34px 0 40px}.meta a{margin-left:0}.article-hero h1{font-size:2.05rem}.conclusion{grid-template-columns:1fr}.conclusion>span{display:block;padding:8px 14px}.article-layout{padding-top:28px;gap:24px}.toc{grid-template-columns:1fr;gap:10px;margin-bottom:34px}.article-section{padding-left:0;padding-bottom:40px}.article-section:before{display:none}.section-number{position:static;margin-bottom:10px}.article-section h2{font-size:1.25rem}.article-section p{font-size:.81rem}.source-box{grid-template-columns:1fr;gap:8px}.article-cta{display:block;padding:23px 20px}.cta-links{text-align:left;margin-top:17px}.side{grid-template-columns:1fr}}
</style>
